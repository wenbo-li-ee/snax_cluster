// Dual VersaCore Int16x4 accelerator cluster configuration
// Multi-shape (S0/S1/S2) with runtime selection via ARRAY_SHAPE CSR
// Single data type: int16x4 only (data_type=0)
// 8 MB TCDM, 48 TCDM ports (16+8+8+8+8)
// Based on snax_dual_versacore_swiglu_cluster.hjson

{
    nr_s1_quadrant: 1
    s1_quadrant:
    {
        nr_clusters: 1
    }
    cluster:
    {
        name: snax_dual_versacore_int16x4_cluster
        bender_target:
        [
            snax_dual_versacore_int16x4_cluster
            snax_dual_versacore_swiglu
            sparse_interconnect
        ]
        boot_addr: 4096
        cluster_base_addr: 268435456
        cluster_base_offset: 4194304
        cluster_base_hartid: 0
        addr_width: 48
        data_width: 64
        user_width: 3
        tcdm:
        {
            size: 8192
            banks: 64
            sparse_interconnect: true
        }
        cluster_periph_size: 64
        zero_mem_size: 64
        dma_data_width: 512
        dma_axi_req_fifo_depth: 16
        dma_req_fifo_depth: 8
        observable_pin_width: 8
        narrow_trans: 4
        wide_trans: 32
        dma_user_width: 1
        enable_debug: false
        vm_support: false
        sram_cfg_expose: true
        sram_cfg_fields:
        {
            ema: 3
            emaw: 2
            emas: 1
        }
        timing:
        {
            lat_comp_fp32: 3
            lat_comp_fp64: 3
            lat_comp_fp16: 2
            lat_comp_fp16_alt: 2
            lat_comp_fp8: 1
            lat_comp_fp8_alt: 1
            lat_noncomp: 1
            lat_conv: 1
            lat_sdotp: 2
            fpu_pipe_config: BEFORE
            narrow_xbar_latency: CUT_ALL_PORTS
            wide_xbar_latency: CUT_ALL_PORTS
            register_core_req: true
            register_core_rsp: true
            register_offload_req: true
            register_offload_rsp: true
            register_ext_narrow: true
            register_ext_wide: true
        }
        hives:
        [
            {
                icache:
                {
                    size: 8
                    sets: 2
                    cacheline: 256
                }
                cores:
                [
                    {
                        $ref: "#/snax_dual_versacore_int16x4_core_template"
                    }
                    {
                        $ref: "#/dma_core_template"
                    }
                ]
            }
        ]
    }
    dram:
    {
        address: 2147483648
        length: 2147483648
    }
    peripherals:
    {
        clint:
        {
            address: 4294901760
            length: 4096
        }
    }
    snax_dual_versacore_int16x4_core_template:
    {
        isa: rv32ima
        xssr: false
        xfrep: false
        xdma: false
        xf16: false
        xf16alt: false
        xf8: false
        xf8alt: false
        xfdotp: false
        xfvec: false
        snax_acc_cfg:
        [
            {
                snax_acc_name: snax_dual_versacore_swiglu
                bender_target:
                [
                    snax_dual_versacore_swiglu
                ]
                // 3 readers: A(16ch) + B0(8ch) + B1(8ch) = 32
                // 2 writers: D0(8ch) + D1(8ch) = 16
                // Total TCDM ports = 48
                snax_tcdm_ports: 48
                sparse_interconnect_config:
                [
                    [
                        16
                        4
                    ]
                    [
                        8
                        4
                    ]
                    [
                        8
                        4
                    ]
                    [
                        8
                        4
                    ]
                    [
                        8
                        4
                    ]
                ]
                snax_num_rw_csr: 20
                snax_num_ro_csr: 2
                // Single data type: int16x4 only (data_type=0)
                snax_versacore_mac_num:
                [
                    256
                ]
                snax_versacore_input_a_element_width:
                [
                    16
                ]
                snax_versacore_input_a_data_type:
                [
                    SInt
                ]
                snax_versacore_input_b_element_width:
                [
                    4
                ]
                snax_versacore_input_b_data_type:
                [
                    SInt
                ]
                snax_versacore_input_c_element_width:
                [
                    32
                ]
                snax_versacore_input_c_data_type:
                [
                    SInt
                ]
                snax_versacore_output_d_element_width:
                [
                    32
                ]
                snax_versacore_output_d_data_type:
                [
                    SInt
                ]
                // Max A width: S0+int16 = 8*8*16 = 1024 bits
                snax_versacore_array_input_a_width: 1024
                // Max B width: S1+int8 = 8*8*8 = 512, S2+int4 = 8*16*4 = 512
                snax_versacore_array_input_b_width: 512
                // C/D width: meshRow*meshCol*32 = 32*32 = 1024
                snax_versacore_array_input_c_width: 1024
                snax_versacore_array_output_d_width: 1024
                snax_versacore_serial_a_width: 1024
                snax_versacore_serial_b_width: 512
                snax_versacore_serial_c_d_width: 1024
                snax_versacore_adder_tree_delay: 0
                // Spatial unrolling: [data_type][array_shape][meshRow, tileSize, meshCol]
                // Single data_type=0 (int16x4): S0(8,8,4), S1(4,8,8), S2(2,8,16)
                snax_versacore_spatial_unrolling:
                [
                    [
                        [
                            8
                            8
                            4
                        ]
                        [
                            4
                            8
                            8
                        ]
                        [
                            2
                            8
                            16
                        ]
                    ]
                ]
                snax_versacore_temporal_unrolling:
                [
                    output_stationary
                ]
                // PostprocLanes = 32 (= meshRow*meshCol for all shapes)
                // ElemsPerBeat = 32, NumChunks = 1
                snax_dual_versacore_postproc_lanes: 32
                snax_streamer_cfg:
                {
                    $ref: "#/snax_dual_versacore_int16x4_streamer_template"
                }
                granularity_a: 4
                granularity_b: 2
                granularity_c_d: 8
            }
        ]
        snax_use_custom_ports: false
        num_int_outstanding_loads: 1
        num_int_outstanding_mem: 4
        num_fp_outstanding_loads: 4
        num_fp_outstanding_mem: 4
        num_sequencer_instructions: 16
        num_dtlb_entries: 1
        num_itlb_entries: 1
    }
    dma_core_template:
    {
        isa: rv32ima
        snax_xdma_cfg:
        {
            bender_target:
            [
                snax_dual_versacore_int16x4_cluster_xdma
            ]
            cfg_io_width: 32
            max_multicast: 16
            max_dimension: 5
            max_mem_size: 4096
            reader_buffer: 12
            writer_buffer: 12
            reader_agu_temporal_dimension: 5
            writer_agu_temporal_dimension: 5
            writer_extensions:
            {
                HasVerilogMemset: {}
            }
            reader_extensions: {}
        }
        xdma: true
        xssr: false
        xfrep: false
        xf16: false
        xf16alt: false
        xf8: false
        xf8alt: false
        xfdotp: false
        xfvec: false
        num_int_outstanding_loads: 1
        num_int_outstanding_mem: 4
        num_fp_outstanding_loads: 4
        num_fp_outstanding_mem: 4
        num_sequencer_instructions: 16
        num_dtlb_entries: 1
        num_itlb_entries: 1
    }
    // Streamer: 3 readers (A, B0, B1) + 2 writers (D0, D1)
    // A: 16ch, B0/B1: 8ch each, D0/D1: 8ch each
    snax_dual_versacore_int16x4_streamer_template:
    {
        data_reader_params:
        {
            spatial_bounds:
            [
                [
                    16
                ]
                [
                    8
                ]
                [
                    8
                ]
            ]
            temporal_dim:
            [
                6
                4
                4
            ]
            num_channel:
            [
                16
                8
                8
            ]
            fifo_depth:
            [
                8
                8
                8
            ]
            configurable_channel:
            [
                1
                1
                1
            ]
            tcdm_logic_word_size:
            [
                [
                    256
                    128
                    64
                ]
                [
                    256
                    128
                    64
                ]
                [
                    256
                    128
                    64
                ]
            ]
        }
        data_writer_params:
        {
            spatial_bounds:
            [
                [
                    8
                ]
                [
                    8
                ]
            ]
            temporal_dim:
            [
                4
                4
            ]
            num_channel:
            [
                8
                8
            ]
            fifo_depth:
            [
                1
                1
            ]
            configurable_channel:
            [
                1
                1
            ]
            tcdm_logic_word_size:
            [
                [
                    256
                    128
                    64
                ]
                [
                    256
                    128
                    64
                ]
            ]
        }
        snax_library_name: dual-versacore-swiglu
    }
}
