        </mxCell>

        <mxCell id="dBuf" value="&lt;b&gt;① Decoupled elastic buffer&lt;/b&gt;&lt;br&gt;&lt;br&gt;in_data/valid → [ DATA register | valid bit ] → out_data/valid&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#688096&quot;&gt;ready = ¬valid ∨ out_ready · refill and drain may occur together&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#C8D4DF;strokeWidth=2;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1058" y="162" width="484" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="dRes" value="&lt;b&gt;② RescaleDown lane&lt;/b&gt;&lt;br&gt;&lt;br&gt;x − z&lt;sub&gt;in&lt;/sub&gt; → signed 64b × M → rounding bias → arithmetic ≫ s → + z&lt;sub&gt;out&lt;/sub&gt; → clamp int16&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#688096&quot;&gt;y = sat16(round((x − zin)·M / 2ˢ) + zout) · registered output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF6;strokeColor=#C5E2D4;strokeWidth=2;fontSize=11;fontColor=#1B9365;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1058" y="290" width="484" height="122" as="geometry"/>
        </mxCell>
        <mxCell id="dSilu" value="&lt;b&gt;③ SiLU polynomial lane · Q16.11&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stage 0: segment detector → coefficient LUT {a₂,a₁,a₀}&lt;br&gt;Stage 1: Horner 0, t₀ = a₂·x + a₁&lt;br&gt;Stage 2: Horner 1, y = t₀·x + a₀&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#688096&quot;&gt;stage_ready propagates backward; CE[0:2] freezes data and valid together&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF6;strokeColor=#C5E2D4;strokeWidth=2;fontSize=11;fontColor=#1B9365;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1058" y="428" width="484" height="178" as="geometry"/>
        </mxCell>
        <mxCell id="dMul" value="&lt;b&gt;④ Element-wise multiplier lane&lt;/b&gt;&lt;br&gt;&lt;br&gt;input FIFO 0 + input FIFO 1 → matched join (V₀ ∧ V₁ ∧ out_ready) → signed int16 × int16 → int32 output register&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#688096&quot;&gt;No corresponding token is consumed until both operands are available.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9EF;strokeColor=#EAD0A8;strokeWidth=2;fontSize=11;fontColor=#B96D08;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1058" y="622" width="484" height="122" as="geometry"/>
        </mxCell>
